# ── CRA build flags ──────────────────────────────────────────────────────────
# Disabling source-map generation: (1) silences unfixable "Failed to parse
# source map" warnings from third-party bundles (e.g. @mediapipe/tasks-vision
# pulled in via @react-three/drei), (2) faster builds, (3) smaller deploys.
GENERATE_SOURCEMAP=false
